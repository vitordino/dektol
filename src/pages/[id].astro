---
import { getData } from 'src/utils/getData'
import { getPathData } from 'src/utils/getPathData'
import DefaultLayout from 'src/components/DefaultLayout.astro'
import type { Props as DefaultLayoutProps } from 'src/components/DefaultLayout.astro'
import Slice from 'src/components/Slice.astro'
import HorizontalScroll from 'src/components/HorizontalScroll.astro'
import HomeItem from 'src/components/HomeItem.astro'

export const getStaticPaths = async () => {
  const { children } = await getData()
  return children?.map(({ name }) => ({ params: { id: name } }))
}

const { name, meta, children } = await getPathData(Astro.params.id || '')
const homeData = await getData()

const layoutProps: DefaultLayoutProps = {
  headerTitle: meta?.title || name,
  background: meta?.background || homeData?.meta?.background || undefined,
  foreground: meta?.foreground || homeData?.meta?.foreground || undefined,
  metaTitle: meta?.meta_title || undefined,
  metaDescription: meta?.meta_description || undefined,
  metaImage: meta?.meta_image || undefined,
}

const paginationItems = homeData?.children
  ?.filter(({ name, meta }) => name !== Astro.params.id && !meta?.hidden)
  ?.map(x => ({ ...x, children: x.children.flatMap(x => x.children) }))
---

<DefaultLayout {...layoutProps}>
  <div class='page-content'>
    {/* [TODO]: image order control on api layer */}
    {children?.map(x => <Slice {...x} children={x.children.reverse()} />)}
  </div>
  <div class='pagination-spacer'></div>
  <div class='pagination-wrapper'>
    <HorizontalScroll class='home-items'>
      {paginationItems?.map(x => <HomeItem {...x} />)}
    </HorizontalScroll>
  </div>
</DefaultLayout>

<style is:global>
  .page-content {
    padding: 48px 0 64px;
  }

  @media (min-width: 720px) {
    .page-content {
      padding: 0;
    }

    .pagination-spacer {
      padding-top: 100vh;
    }

    .pagination-wrapper {
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      right: 0;
    }
  }
</style>
