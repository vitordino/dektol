---
import getBase64FromImageUrl from 'src/utils/getBase64FromImageUrl'

export type Props = {
  path: string
  name: string
  meta?: { size?: { width?: number; height?: number } }
}
const props = Astro.props as Props
const { path, meta, name } = props
const ratio = meta?.size?.width && meta.size.height ? meta?.size?.width / meta?.size?.height : 1

const getFormat = (ratio: number) => {
  if (ratio === 1) return 'square'
  if (ratio > 1) return 'landscape'
  return 'portrait'
}

const filename = decodeURIComponent(path)
  ?.split('_')
  ?.splice(1)
  ?.join(',')
  ?.replaceAll('+', ' ')
  ?.replaceAll(',,,,', '____')
  ?.replace(/\.jpe?g$/i, '')

const getPhotoMetaArray = (x: string) =>
  x
    .split(', ')
    ?.map(x => x.trim())
    ?.filter(Boolean) || []

const hasValidPhotoMeta = getPhotoMetaArray(filename).length >= 7

const photoMeta = getPhotoMetaArray(filename)

const alt = name || hasValidPhotoMeta ? photoMeta.join('\n') : ''
// [TODO]: flexible base url
const blurHash = await getBase64FromImageUrl(`http://localhost:3001/${path}?h=16`)
---

<div class='image-wrapper' data-format={getFormat(ratio)}>
  <div class='image-wrapper-inner' data-map='item'>
    {blurHash && <img class='image-blurhash' src={blurHash} aria-hidden='true' />}
    <img
      class='image-main'
      src={path}
      loading='lazy'
      data-loaded='false'
      alt={alt}
      {...meta?.size}
      onload='handleImageLoad(this)'
    />
  </div>
</div>

<style is:global>
  .image-wrapper {
    pointer-events: auto;
  }
  .image-wrapper-inner {
    position: relative;
    overflow: hidden;
  }

  .image-blurhash {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
    max-width: none;
    transition: 0s display 0.75s;
    user-select: none;
  }

  .image-main {
    position: relative;
    transition: 0.5s opacity;
    height: auto;
    width: 100%;
    user-select: none;
  }

  .image-main img {
    pointer-events: auto;
  }

  html[data-js='true'] .image-main[data-loaded='false'] {
    opacity: 0;
  }

  html[data-js='true'] .image-main[data-loaded='true'] {
    opacity: 1;
  }

  html[data-js='true'] .image-main[data-loaded='true'] ~ .image-blurhash {
    display: none;
  }
</style>
