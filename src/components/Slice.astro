---
import HorizontalSlice from 'src/components/HorizontalSlice.astro'
import type { FileSystemSectionSchema } from 'src/types'
export type Props = FileSystemSectionSchema
const props = Astro.props as Props
---

<HorizontalSlice {...props} />

<style is:global>
  .slice {
    position: relative;
    z-index: 1;
  }

  @media (min-width: 720px) {
    .slice:last-of-type:before {
      content: '';
      position: absolute;
      top: 0;
      bottom: -1px;
      left: 0;
      right: 0;
      border-bottom: 1px solid var(--foreground);
      opacity: 0.1;
    }
  }
</style>
